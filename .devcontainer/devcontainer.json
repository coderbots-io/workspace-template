{
  "name": "agent-dev-desktop",
  // Prebuilt image instead of a per-create Dockerfile build. The heavy
  // Dockerfile layers (XFCE + Chrome + KasmVNC + apt + uv) AND the devcontainer
  // features (node, python, sshd, github-cli, docker-in-docker) are baked into
  // this image by .github/workflows/prebuild-image.yml (which builds from
  // .devcontainer/build.devcontainer.json). A cold codespace create now just
  // *pulls* this image — no ~5–15 min from-scratch rebuild.
  //
  // The features are NOT relisted here on purpose: they're baked into the image
  // and re-applied at create time from its `devcontainer.metadata` label (so
  // DinD's dockerd, sshd, etc. still start). The source of truth for what's in
  // the image is .devcontainer/build.devcontainer.json — edit features THERE and
  // the next prebuild republishes this tag.
  //
  // The image is public on GHCR so every per-account `coderbots-workspace` repo
  // (generated from this template, in any org) can pull it without auth. To roll
  // back to building locally, swap this line for:
  //   "build": { "dockerfile": "Dockerfile" }, plus the features block.
  "image": "ghcr.io/coderbots-io/workspace-template:latest",
  // Storage tier. 32gb keeps codespaces on the cheapest machine
  // (basicLinux32gb: 2 cores / 8GB RAM / 32GB storage) — GitHub couples storage
  // to machine size, and requiring 64gb would force the 8-core premium machine.
  // Trade-off: less headroom for many large Docker images; bump back to "64gb"
  // (and the machine pin in lib/github.ts) if image space becomes the bottleneck.
  "hostRequirements": { "storage": "32gb" },
  // 6080 must be in forwardPorts so the public forwarded URL
  // (<codespace>-6080.app.github.dev) actually maps to it. Auto-forward only
  // fires when the VS Code editor client detects the listener; the Codespaces
  // Manager app starts the desktop headlessly over `gh codespace ssh` with no
  // editor attached, so without this the port is never forwarded and the URL
  // 404s. The downside — the forwarder transiently pre-binds 6080 at boot, so a
  // desktop launched right then dies with EADDRINUSE — is handled by
  // start-desktop.sh, which retries until the pre-bind releases and KasmVNC
  // binds (post-boot 6080 is reliably free).
  // 8787 is the bridge's log-stream WebSocket (claude-slack-bot/logserver.py),
  // which Central's "Logs" page reads. Like 6080 it must be in forwardPorts so
  // the forwarded URL (<codespace>-8787.app.github.dev) maps to it even though
  // the codespace is started headlessly over `gh codespace ssh` with no editor
  // client to auto-forward it. It stays PRIVATE — only requests carrying an
  // X-Github-Token for someone with access to this codespace reach it (Central
  // attaches that header when it proxies the stream).
  "forwardPorts": [6080, 8787],
  "portsAttributes": {
    "6080": { "label": "desktop (KasmVNC)", "onAutoForward": "openPreview" },
    "8787": { "label": "agent logs", "onAutoForward": "silent" }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "BROWSER": "/usr/local/bin/google-chrome"
  },
  // Install the agent CLI, make the projects dir, and pre-install the setup
  // wizard's deps so the folderOpen autostart task launches instantly (no npm
  // install on first open). Runs in the workspace folder (/workspaces/<repo>).
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && mkdir -p $HOME/projects && npm --prefix setup-wizard install",
  // Start the bridge under supervisord on every codespace start. supervisord
  // daemonizes and keeps it alive (restart/backoff/logging). On the very first
  // boot the bridge has no .env yet — it waits, re-reading .env every few seconds
  // until Central's provisioning writes the keys (see wait_for_config in
  // bridge.py). The /workspaces volume persists across stop/start, so on
  // later starts the .env is already there and the bridge comes up immediately.
  "postStartCommand": "supervisord -c claude-slack-bot/supervisord.conf || true",
  // The desktop is intentionally NOT started here. A KasmVNC launched from a
  // lifecycle command (postStart/postCreate) is reaped by Codespaces shortly
  // after the command finishes, so it's reliably down by the time anyone
  // connects. The Codespaces Manager app starts it on demand by running
  // /usr/local/bin/start-desktop.sh over `gh codespace ssh` (an exec context
  // that survives), which is where the desktop actually stays up.
  "remoteUser": "vscode"
}
