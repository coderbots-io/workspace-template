{
  // Build-time devcontainer config — the SOURCE OF TRUTH for the prebuilt image.
  //
  // .github/workflows/prebuild-image.yml feeds THIS file to `devcontainers/ci`,
  // which builds the Dockerfile, layers the features below on top, embeds a
  // `devcontainer.metadata` image label describing them, and pushes the result to
  //   ghcr.io/coderbots-io/workspace-template:latest
  //
  // The runtime ./devcontainer.json then just references that image via "image":
  // — no "build", no "features". The features are baked in and re-applied at
  // create time from the image metadata label (that's how DinD/sshd/etc. keep
  // working without being rebuilt), so a cold codespace create only has to *pull*
  // the image instead of running the whole Dockerfile + feature install (the
  // ~5–15 min cold-build the prebuild eliminates).
  //
  // IMPORTANT: keep the features here in sync with what the runtime config
  // expects. This file is intentionally NOT named `devcontainer.json` and is not
  // inside a subfolder, so GitHub Codespaces does NOT auto-discover it as a
  // selectable configuration — only the CI workflow points at it (via configFile).
  "name": "agent-dev-desktop (image build)",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/sshd:1": {},
    // gh CLI: the setup wizard's pick-repo step uses it (gh repo list / secret
    // set / repo clone), and Central drives the desktop over `gh codespace ssh`.
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Docker-in-Docker: agents run lots of cloned apps here, many of which ship a
    // docker-compose (esp. DB-backed ones) — run them in containers instead of
    // installing services onto the codespace. Keeps apps isolated and the base
    // image clean.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "remoteUser": "vscode"
}
