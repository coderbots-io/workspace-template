#!/usr/bin/env python3
"""Ask the user for app secrets WITHOUT routing them through Slack or the model.

The agent runs this when an app it's setting up needs secret env vars (API keys,
DB URLs, ...). Instead of asking the user to paste secrets into chat — where they'd
land in Slack history and the model's context — we register a request with Central
and print a one-time URL. The agent gives that URL to the user; they open it and
enter the values in a browser (HTTPS), and Central pushes them to this workspace
over the event bus. The bridge writes them into the target .env; the values never
touch this process, Slack, or the agent's context.

Usage:
  collect-user-secrets [--target <dir-or-.env-path>] KEY [KEY ...]

  --target   Where to write the .env: a repo directory (a `.env` is created/
             updated inside it) or an explicit path ending in `.env`.
             Defaults to the current directory.

  KEY ...    The env var names the app needs, e.g. STRIPE_SECRET_KEY DATABASE_URL

Prints the URL to stdout. Config (written by bridge.py) is read from
~/.config/coderbots/pull.env: CENTRAL_TOKEN_URL, CENTRAL_PULL_SECRET.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
CONFIG = os.environ.get(
    "CODERBOTS_PULL_ENV", os.path.join(HOME, ".config/coderbots/pull.env")
)
HTTP_TIMEOUT = 15
ENV_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def _read_config() -> dict[str, str]:
    cfg: dict[str, str] = {}
    try:
        with open(CONFIG) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return cfg


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--target", default=".")
    ap.add_argument("keys", nargs="+")
    args = ap.parse_args()

    keys = []
    for k in args.keys:
        if not ENV_NAME.match(k):
            print(f"invalid env var name: {k!r}", file=sys.stderr)
            return 2
        if k not in keys:
            keys.append(k)

    # Resolve the target to an absolute path so the bridge writes where the agent
    # meant, regardless of its own cwd.
    target = os.path.abspath(os.path.expanduser(args.target))

    cfg = _read_config()
    token_url = cfg.get("CENTRAL_TOKEN_URL")
    secret = cfg.get("CENTRAL_PULL_SECRET")
    if not token_url or not secret:
        print(
            "missing CENTRAL_TOKEN_URL / CENTRAL_PULL_SECRET in pull config",
            file=sys.stderr,
        )
        return 1
    # The per-codespace secrets endpoint is a sibling of the github-token one.
    url = token_url.replace("/github-token", "/secrets")

    body = json.dumps({"keys": keys, "target": target}).encode()
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {secret}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:300]
        print(f"request failed ({e.code}): {detail}", file=sys.stderr)
        return 1
    except (urllib.error.URLError, ValueError, OSError) as e:
        print(f"request failed: {e}", file=sys.stderr)
        return 1

    link = data.get("url")
    if not link:
        print("no url in response", file=sys.stderr)
        return 1
    print(link)
    return 0


if __name__ == "__main__":
    sys.exit(main())
